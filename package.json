{
  "name": "@johnmorrisdotca/kyuubu",
  "version": "1.3.2",
  "description": "Turning cube for the browser: a 3D twisty-puzzle cube simulator in the manner of the Rubik's Cube, 2×2 to 7×7, in plain CSS 3D. Drag, touch, keys or notation. Replay world record solves move for move; embed one with a tag or an iframe. Scrambles, a step-by-step solve, a command line, React, Vue, Svelte, Angular or plain HTML. Zero dependencies.",
  "keywords": [
    "cube",
    "rubiks-cube",
    "rubiks",
    "rubik",
    "magic-cube",
    "twisty-puzzle",
    "puzzle",
    "speedcubing",
    "speedcube",
    "cubing",
    "cube-simulator",
    "virtual-cube",
    "3d-cube",
    "css-3d",
    "css3d",
    "no-canvas",
    "2x2",
    "3x3",
    "4x4",
    "5x5",
    "6x6",
    "7x7",
    "nxn",
    "nxn-cube",
    "scramble",
    "scrambler",
    "scramble-generator",
    "cube-scramble",
    "seeded",
    "cube-solver",
    "solver",
    "layer-by-layer",
    "beginner-method",
    "lbl",
    "cube-notation",
    "notation",
    "algorithm",
    "algorithms",
    "cube-model",
    "cube-state",
    "puzzle-game",
    "game",
    "drag",
    "touch",
    "keyboard",
    "accessible",
    "theming",
    "themes",
    "color-scheme",
    "typescript",
    "javascript",
    "react",
    "react-component",
    "vue",
    "svelte",
    "angular",
    "vanilla-js",
    "esm",
    "zero-dependencies",
    "cli",
    "command-line",
    "json",
    "csv",
    "export",
    "import",
    "i18n",
    "japanese",
    "education",
    "world-record",
    "reconstruction",
    "replay",
    "web-component",
    "custom-element",
    "embed",
    "iframe",
    "wca"
  ],
  "homepage": "https://johnmorrisdotca.github.io/kyuubu/",
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/kyuubu/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/kyuubu.git"
  },
  "license": "MIT",
  "author": {
    "name": "John Morris",
    "email": "john@johnmorris.ca",
    "url": "https://johnmorris.ca"
  },
  "sideEffects": [
    "./dist/element-define.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    },
    "./famous": {
      "types": "./dist/famous.d.ts",
      "default": "./dist/famous.js"
    },
    "./player": {
      "types": "./dist/player.d.ts",
      "default": "./dist/player.js"
    },
    "./element": {
      "types": "./dist/element.d.ts",
      "default": "./dist/element.js"
    },
    "./element/define": {
      "types": "./dist/element-define.d.ts",
      "default": "./dist/element-define.js"
    }
  },
  "bin": {
    "kyuubu": "bin/kyuubu.mjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/mark-esm.mjs",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "demo": "pnpm site",
    "test:site": "pnpm site && playwright test",
    "test:cli": "pnpm build && node scripts/check-cli.mjs",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "docs:make": "node scripts/docs.mjs",
    "prepublishOnly": "pnpm check",
    "solve:check": "pnpm build && node scripts/solve-check.mjs"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/react": "^19",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "react": "^19",
    "typescript": "^5",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0"
}
